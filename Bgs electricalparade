<!-- ===== MODAL ===== -->
<div class="modal-wrap" id="modalBg" role="dialog" aria-modal="true" aria-labelledby="modalNameEn">
  <div class="modal-panel">
    <button class="modal-close-btn" id="modalClose" aria-label="閉じる">✕ Close</button>
    <div class="modal-name-en" id="modalNameEn"></div>
    <div class="modal-name-ja" id="modalNameJa"></div>
    <p class="modal-desc" id="modalDesc"></p>
  </div>
</div>

<script>
  /* ─── クリエイターデータ ─── */
  const members = {
    jani: {
      en: "Robert \"Bob\" Jani",
      ja: "ロバート（ボブ）・ジャニ",
      desc: "ディズニーのエンターテイメント部門を統括した伝説の責任者です。WDWの暗闇に包まれた湖を見て「エレクトリカル・ウォーター・ページェント」を着想。さらにアナハイムでの陸上パレード化（MSEP）を指揮し、「夜間パレード」という全く新しいエンターテイメントのジャンルを確立した、光の魔法のグランドデザイナーです。「暗闇を怖がってはいけない。暗闇こそが、光を最も美しく見せる舞台なのだから」という彼の言葉は、今もイマジニアたちの精神的な支柱となっています。"
    },
    miziker: {
      en: "Ron Miziker",
      ja: "ロン・ミジカー",
      desc: "エレクトリカルパレードの初期開発においてプロジェクトディレクターを務めた人物です。ボブ・ジャニとともに、外部委託先との困難な交渉や、直前の突貫工事といった数々の壁を乗り越えました。メインストリートの建物へのフロートの衝突や、衣装から火花が散るリハーサルといった危機に直面しながらも、「最悪の状況の中でこそ、最高のものが生まれる」と信じ続け、奇跡の初演を成功へと導きました。"
    },
    dorsey: {
      en: "Don Dorsey",
      ja: "ドン・ドーシー",
      desc: "1977年のパレードアップデートから音楽監督および編曲を担った電子音楽の巨匠です。ジャック・ワーグナーが発掘した「バロック・ホウダウン」をベースに、象徴的なオープニングファンファーレや、ボコーダーを用いた幻想的なボイス、各ディズニー作品のメロディを緻密に織り込んだシンセサイザー・アレンジメントを構築し、MSEPの音楽的アイデンティティを確立しました。彼のアレンジなしに、あのパレードの「音の世界観」は生まれなかったと言っても過言ではありません。"
    },
    smith: {
      en: "Gregory Smith",
      ja: "グレゴリー・スミス",
      desc: "2001年に東京ディズニーランドで始まった「エレクトリカルパレード・ドリームライツ」の音楽を手掛けた作曲家・編曲家です。「バロック・ホウダウン」が持つ独特の電子的なトイ・サウンドの魅力を損なうことなく、背後にフルオーケストラによる壮大な交響楽的アレンジを重ねるという繊細な作業を成し遂げました。「電子音とオーケストラは対立するものではなく、互いの美しさを引き立て合うものだ」という彼の信念が、ドリームライツの音楽に永遠の命を吹き込んでいます。"
    }
  };

  /* Reveal on scroll */
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) { 
        e.target.classList.add('on'); 
        io.unobserve(e.target); 
      }
    });
  }, { threshold: 0.05, rootMargin: '0px 0px 50px 0px' });
  
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));

  /* ファーストビューの要素を即時表示 */
  setTimeout(() => {
    document.querySelectorAll('.reveal').forEach((el, index) => {
      if(index < 3) el.classList.add('on');
    });
  }, 50);

  /* ─── モーダル ─── */
  const modalBg = document.getElementById('modalBg');
  const modalClose = document.getElementById('modalClose');

  function openModal(id) {
    const d = members[id];
    if (!d) return;
    document.getElementById('modalNameEn').textContent = d.en;
    document.getElementById('modalNameJa').textContent = d.ja;
    document.getElementById('modalDesc').textContent = d.desc;
    modalBg.classList.add('open');
    modalClose.focus();
  }
  function closeModal() { modalBg.classList.remove('open'); }

  document.querySelectorAll('.creator-card').forEach(card => {
    card.addEventListener('click', () => openModal(card.dataset.member));
    card.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openModal(card.dataset.member);
      }
    });
  });
  modalClose.addEventListener('click', closeModal);
  modalBg.addEventListener('click', e => { if (e.target === modalBg) closeModal(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

  /* Image protection */
  document.addEventListener('contextmenu', e => { if (e.target.tagName === 'IMG') e.preventDefault(); });
  document.addEventListener('dragstart', e => { if (e.target.tagName === 'IMG') e.preventDefault(); });
</script>
</body>
</html>
